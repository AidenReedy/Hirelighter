# Copy to .env next to docker-compose.yml and fill in.

# IP the app listens on. Use the machine's Tailscale address (run `tailscale ip -4`).
# Never 0.0.0.0, and never port-forward this.
BIND_IP=100.x.y.z
PORT=8080
# Timezone for dates the server fills in, e.g. America/Los_Angeles
TZ=UTC
# Longest bullet (in characters) that fits on one line; 107 suits the default template
MAX_BULLET_CHARS=107

# Optional second layer: HTTP basic auth. Leave blank to turn it off.
APP_USER=admin
APP_PASSWORD=

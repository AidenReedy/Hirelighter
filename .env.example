# Copy to .env next to docker-compose.yml and fill in.

# IP the app listens on. Leave blank to listen on all of this machine's IPs (LAN + Tailscale).
# Set one address (e.g. 127.0.0.1 or your Tailscale 100.x IP) to restrict it. Never port-forward this.
BIND_IP=
PORT=8080
# Timezone for dates the server fills in, e.g. America/Los_Angeles
TZ=UTC
# Longest bullet (in characters) that fits on one line; 107 suits the default template
MAX_BULLET_CHARS=107

# Login prompt for the whole app (recommended). Leave the password blank to turn it off.
APP_USER=admin
APP_PASSWORD=

# Gmail rejection tracking (optional; start it with `docker compose --profile mail up -d`).
# Use an app password (Google Account > Security > App passwords), never your real password.
# It can read your whole mailbox, so keep this file private: chmod 600 .env
GMAIL_USER=
GMAIL_APP_PASSWORD=
# The Gmail label to read. Add a Gmail filter that puts application emails here.
GMAIL_LABEL=Jobs
MAIL_CHECK_MINUTES=15
# 1 = clear rejections update the status on their own (with Undo); 0 = everything waits for you
MAIL_AUTO_APPLY=1
